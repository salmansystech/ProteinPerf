# Profiling assistant (`python -m proteinperf ask`). Copy to .env and fill in.
# Local Ollama (free, no key): http://localhost:11434, then `ollama pull <model>`
# Ollama Cloud: https://ollama.com with an API key from ollama.com/settings/keys
OLLAMA_BASE_URL=http://localhost:11434
# Any Ollama model that supports tool calling
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_KEY=
